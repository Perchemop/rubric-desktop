<Project Sdk="Microsoft.NET.Sdk">
  <!--
    WiX v4 setup project. Built in CI by .github/workflows/package.yml via
    `dotnet build` (or `wix build`) — never locally: the constraint on this
    machine forbids heavy toolchain runs (AGENTS.md "CI-first").

    The product definition is deliberately kept in this repository (rather than
    generated by an opaque script) so the installer metadata is reviewable.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <IsPackable>false</IsPackable>
    <SelfContained>false</SelfContained>
    <!-- WiX v4 uses an SDK-style project: no PackageReference needed beyond the
         tooling the CLI provides, so this file only pins the language. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Product.wxs is the installer definition, built directly by the WiX CLI
         in .github/workflows/package.yml (`wix build Product.wxs ...`). This
         project exists only so tooling that expects a .csproj has one to load. -->
    <None Include="Product.wxs" />
  </ItemGroup>
</Project>
