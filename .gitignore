# Local-only files (never commit, never push)
# Personal notes and generated test documents live outside this repository
# and must stay there.
# Note: docs/spec/ holds Rubric's own original requirement set (Phase 1).
*.pdf
guide.md

# Secrets
.env
.env.*
!.env.example
secrets/
*.keystore
*.jks
*.p12
*.pem

# Rust / build
/target/
**/*.rs.bk
*.profraw

# OS / editor
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python bytecode caches — a .pyc embeds the absolute source path, which is a
# personal-data leak in a public repository (guide II.29).
__pycache__/
*.pyc
